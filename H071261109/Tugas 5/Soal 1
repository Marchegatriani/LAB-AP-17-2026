ALFABET = "abcdefghijklmnopqrstuvwxyz"


def bersihkan_teks(teks):
    """Simpan hanya huruf (cek manual ke ALFABET), ubah ke huruf kecil."""
    hasil = ""
    for ch in teks:
        if ch.lower() in ALFABET:
            hasil += ch.lower()
    return hasil


def cek_palinrome(teks):
    """(True, -1) jika palindrom, else (False, indeks_pertama_beda)."""
    terbalik = "".join(reversed(teks))
    if teks == terbalik:
        return (True, -1)
    for i in range(len(teks)):
        if teks[i] != terbalik[i]:
            return (False, i)


def inti_palinrome(teks):
    """Cari palindrom terpanjang; jika seri ambil yang paling kiri."""
    terbaik = {"teks": "", "panjang": 0, "indeks_awal": -1}
    n = len(teks)
    for i in range(n):
        for j in range(i + 1, n + 1):
            sub = teks[i:j]
            if len(sub) > terbaik["panjang"] and cek_palinrome(sub)[0]:
                terbaik = {"teks": sub, "panjang": len(sub), "indeks_awal": i}
    return terbaik


if __name__ == "__main__":
    teks = input("Masukkan teks prasasti: ")
    bersih = bersihkan_teks(teks)
    print()
    print("Teks Bersih:", bersih)
    print("Output Terharap:", inti_palinrome(bersih))