def tambah_buku(inventaris, judul, penulis, harga, stok):
    buku = {"judul": judul, "penulis": penulis, "harga": harga, "stok": stok}
    inventaris.append(buku)
    print(f"Buku '{judul}' berhasil ditambahkan!")


def cari_buku(inventaris, kata_kunci):
    kata_kunci = kata_kunci.lower()
    hasil = []
    for buku in inventaris:
        if kata_kunci in buku["judul"].lower():
            hasil.append(buku)

    if not hasil:
        print("Buku tidak ditemukan.")
        return hasil

    print(f"Ditemukan {len(hasil)} buku:")
    for i, b in enumerate(hasil, 1):
        print(f" {i}. {b['judul']} - {b['penulis']} | Rp{b['harga']} | Stok: {b['stok']}")
    return hasil


def update_stok(inventaris, judul, jumlah):
    for buku in inventaris:
        if buku["judul"].lower() == judul.lower():
            stok_baru = buku["stok"] + jumlah
            if stok_baru < 0:
                print(f"Gagal! Stok '{buku['judul']}' tidak cukup (stok saat ini: {buku['stok']}).")
                return False
            buku["stok"] = stok_baru
            if jumlah >= 0:
                print(f"Stok '{buku['judul']}' bertambah {jumlah}. Stok sekarang: {stok_baru}")
            else:
                print(f"Stok '{buku['judul']}' berkurang {abs(jumlah)}. Stok sekarang: {stok_baru}")
            return True
    print(f"Error! Buku '{judul}' tidak ditemukan.")
    return False


def ringkasan_inventaris(inventaris):
    print("=" * 40)
    print("RINGKASAN INVENTARIS BOOKNEST")
    print("=" * 40)
    if not inventaris:
        print("Inventaris masih kosong.")
        print("=" * 40)
        return

    jenis = len(inventaris)
    total_stok = sum(b["stok"] for b in inventaris)
    total_aset = sum(b["harga"] * b["stok"] for b in inventaris)
    termahal = max(inventaris, key=lambda b: b["harga"])

    print(f"Jumlah jenis buku : {jenis}")
    print(f"Total seluruh stok: {total_stok}")
    print(f"Total nilai aset : Rp{total_aset}")
    print(f"Buku termahal : {termahal['judul']} (Rp{termahal['harga']})")
    print("=" * 40)


def main():
    inventaris = []
    print("=" * 40)
    print(" SISTEM INVENTARIS TOKO BUKU BOOKNEST")
    print("=" * 40)

    while True:
        print("Menu:")
        print("1. Tambah Buku")
        print("2. Cari Buku")
        print("3. Update Stok")
        print("4. Ringkasan Inventaris")
        print("5. Keluar")
        pilihan = input("Pilih menu (1-5): ").strip()

        if pilihan == "1":
            judul = input("Judul buku: ").strip()
            penulis = input("Penulis: ").strip()
            try:
                harga = int(input("Harga: "))
                stok = int(input("Stok awal: "))
                if harga < 0 or stok < 0:
                    print("Error! Harga dan stok tidak boleh negatif.")
                else:
                    tambah_buku(inventaris, judul, penulis, harga, stok)
            except ValueError:
                print("Error! Harga dan stok harus berupa angka.")

        elif pilihan == "2":
            kata_kunci = input("Masukkan kata kunci judul: ")
            cari_buku(inventaris, kata_kunci)

        elif pilihan == "3":
            judul = input("Judul buku yang ingin diupdate: ").strip()
            try:
                jumlah = int(input("Jumlah perubahan (positif=tambah, negatif=kurang): "))
                update_stok(inventaris, judul, jumlah)
            except ValueError:
                print("Error! Jumlah harus berupa angka.")

        elif pilihan == "4":
            ringkasan_inventaris(inventaris)

        elif pilihan == "5":
            print("Terima kasih telah menggunakan BookNest!")
            break

        else:
            print("Pilihan tidak valid. Pilih 1-5.")


if __name__ == "__main__":
    main()