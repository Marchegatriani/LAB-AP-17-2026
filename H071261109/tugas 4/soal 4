def konversi_suhu(suhu, asal, tujuan):
    
    if asal not in ("C", "F", "K") or tujuan not in ("C", "F", "K"):
        raise ValueError("Skala suhu tidak dikenali.")

    if asal == "C":
        celsius = suhu
    elif asal == "F":
        celsius = (suhu - 32) * 5 / 9
    else:
        celsius = suhu - 273.15

    if tujuan == "C":
        return celsius
    elif tujuan == "F":
        return celsius * 9 / 5 + 32
    return celsius + 273.15

print("=== Konversi Suhu ===")
while True:
    suhu = input("Masukkan suhu (atau 'selesai' untuk keluar): ")
    if suhu == "selesai":
        break

    try:
        suhu = float(suhu)
        asal = input("Skala asal (C/F/K): ")
        tujuan = input("Skala tujuan (C/F/K): ")

        hasil = konversi_suhu(suhu, asal, tujuan)
        print(f"Hasil: {suhu} {asal} = {hasil} {tujuan}")
    except ValueError:
        print("Error: Skala suhu tidak dikenali.")